{
  den.aspects.darwin-sketchybar.provides.to-users.homeManager =
    {
      config,
      lib,
      pkgs,
      ...
    }:
    let
      inherit (config.catppuccin) flavor;
      palette = (lib.importJSON "${config.catppuccin.sources.palette}/palette.json").${flavor}.colors;
      argb = alpha: name: "0x${alpha}${lib.removePrefix "#" palette.${name}.hex}";

      colorsLua = pkgs.writeText "colors.lua" ''
        -- Catppuccin ${flavor}, generated by modules/aspects/darwin/sketchybar/default.nix.
        return {
          black = ${argb "ff" "mantle"},
          white = ${argb "ff" "text"},
          red = ${argb "ff" "red"},
          green = ${argb "ff" "green"},
          blue = ${argb "ff" "blue"},
          yellow = ${argb "ff" "yellow"},
          orange = ${argb "ff" "peach"},
          magenta = ${argb "ff" "mauve"},
          grey = ${argb "ff" "overlay2"},
          lavender = ${argb "ff" "lavender"},
          transparent = 0x00000000,

          bar = { bg = ${argb "ff" "base"}, border = ${argb "ff" "surface1"} },
          popup = { bg = ${argb "ff" "base"}, border = ${argb "ff" "text"} },
          bg1 = ${argb "60" "surface0"},
          bg2 = ${argb "60" "surface1"},

          with_alpha = function(color, alpha)
            if alpha > 1.0 or alpha < 0.0 then return color end
            return (color & 0x00ffffff) | (math.floor(alpha * 255.0) << 24)
          end,
        }
      '';

      sketchybarConfig = pkgs.stdenv.mkDerivation {
        name = "sketchybar-config";
        src = ./config;
        nativeBuildInputs = [ pkgs.gnumake ];
        buildPhase = ''
          runHook preBuild
          make -C ./helpers
          runHook postBuild
        '';
        # The app -> glyph map comes from the same font package that
        # darwin/fonts.nix installs, so the two can't drift apart.
        installPhase = ''
          runHook preInstall
          cp -r . $out
          cp ${pkgs.sketchybar-app-font}/lib/sketchybar-app-font/icon_map.lua $out/helpers/app_icons.lua
          cp ${colorsLua} $out/colors.lua
          runHook postInstall
        '';
      };
    in
    {
      # The running bar keeps its old config until reloaded.
      home.activation.reloadSketchybar = lib.hm.dag.entryAfter [ "linkGeneration" ] ''
        if /usr/bin/pgrep -qx sketchybar; then
          run ${config.programs.sketchybar.package}/bin/sketchybar --reload || true
        fi
      '';

      programs.sketchybar = {
        enable = true;
        config = {
          source = sketchybarConfig;
          recursive = true;
        };
        configType = "lua";

        # FelixKratz/SbarLua#67 (unmerged): pops failed callbacks' errors off
        # the Lua stack (thousands of those and callbacks stop firing) and
        # stops exec/delay callbacks, replaced subscriptions and query
        # buffers leaking. Drop once nixpkgs' sbarlua includes it.
        sbarLuaPackage = pkgs.sbarlua.overrideAttrs (old: {
          patches = (old.patches or [ ]) ++ [
            (pkgs.fetchpatch {
              url = "https://github.com/FelixKratz/SbarLua/compare/dba9cc421b868c918d5c23c408544a28aadf2f2f...a016d3380fb3e2ec4df1ffb2d858acbb2272d1c5.patch";
              hash = "sha256-k9zniKIdiqpmVc/enxa8D+sL1u/rQODjlV+E1ieaFyc=";
            })
          ];
        });

        # Runtime dependencies of the lua config. `gnumake` used to be here
        # because helpers/init.lua re-ran `make` on every launch -- the
        # derivation above builds the helpers instead, so it is not needed.
        extraPackages = with pkgs; [
          aerospace # items/spaces.lua queries workspaces
          switchaudio-osx # items/widgets/volume.lua device switcher
        ];
      };
    };
}
